# Stacks this host runs (":"-separated, docker-compose.yml first).
# Leave out the stacks this machine shouldn't run. See README "Choosing stacks per host".
COMPOSE_FILE=docker-compose.yml:compose.network.yml:compose.media.yml:compose.apps.yml:compose.hermes.yml

# General
TZ=Etc/UTC

#PiHole
PIHOLE_WEBPASSWORD=

# Profilarr (external URL as seen by the browser, e.g. https://profilarr.example.com)
PROFILARR_ORIGIN=

# Transmission
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=

# Vaultwarden
VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_PORT=
VAULTWARDEN_SMTP_FROM=
VAULTWARDEN_SMTP_USERNAME=
VAULTWARDEN_SMTP_PASSWORD=
VAULTWARDEN_DOMAIN=
VAULTWARDEN_SIGNUPS_DOMAINS_WHITELIST=

WIREGUARD_URL=
WIREGUARD_PORT=

OBSIDIAN_AUTH_TOKEN=
VAULT_NAME=
VAULT_HOST_PATH=
CONFIG_HOST_PATH=
VAULT_PASSWORD=

# Hermes dashboard basic auth
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_WEBUI_PASSWORD=

# Hevy workout API
HEVY_API_KEY=

#iCloud
ICLOUD_EMAIL=
ICLOUD_PASSWORD=

# Homepage
# Host(s) the dashboard is reached at (comma separated), e.g. homepage.example.com
HOMEPAGE_ALLOWED_HOSTS=
# Base domain for service links, e.g. example.com -> https://jellyfin.example.com
HOMEPAGE_VAR_DOMAIN=
# Weather widget location
HOMEPAGE_VAR_LATITUDE=
HOMEPAGE_VAR_LONGITUDE=
# Widget API keys: *arr/autobrr/seerr under Settings > General, Jellyfin under Dashboard > API Keys
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_SEERR_KEY=
HOMEPAGE_VAR_SONARR_TV_KEY=
HOMEPAGE_VAR_SONARR_ANIME_KEY=
HOMEPAGE_VAR_RADARR_MOVIES_KEY=
HOMEPAGE_VAR_RADARR_ANIME_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_AUTOBRR_KEY=
